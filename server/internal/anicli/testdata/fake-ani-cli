#!/bin/sh
# A stand-in for ani-cli 5.x, used by Kumo's tests unless a real ani-cli is
# given. It behaves like ani-cli where Kumo depends on it: a query is every
# argument that is not one of ani-cli's options; the fzf/rofi/dmenu menus are
# skipped when the list has a single entry (one search result, or an anime
# with one episode, is picked without asking); -S, -e, -q, --dub and
# --exit-after-play; the player invocation; and the "Playing episode N of
# <title>..." menu shown after an episode has been played. The scraping comes
# from scrape-stubs.sh.

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r\033[1;34m%s\033[0m\n" "$*"
}

# shellcheck disable=SC2086
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 ;;
        dmenu) dmenu -l 20 -p "$1" ;;
    esac
}

# $1 = prompt, $2 = multi select flag. Reads an episode list or
# "n<TAB>id<TAB>title" lines and prints the chosen line without its number.
nth() {
    _stdin=$(cat)
    [ -z "$_stdin" ] && return 1
    if [ "$(printf "%s\n" "$_stdin" | wc -l | tr -d '[:space:]')" -eq 1 ]; then
        printf "%s" "$_stdin" | cut -f 2,3
        return 0
    fi
    _line=$(printf "%s" "$_stdin" | cut -f 1,3 | tr '\t' ' ' | menu "$1" "$2" | cut -d " " -f 1)
    [ -n "$_line" ] || return 1
    printf "%s" "$_stdin" | grep -E "^${_line}(\$|[[:space:]])" | cut -f 2,3
}

# shellcheck source=/dev/null
. "${0%/*}/scrape-stubs.sh"

# shellcheck disable=SC2086
play_episode() {
    printf "%s\n" "$ep_list" | grep -qx "$ep_no" || die "Invalid episode!"
    hianime_m3u8 "$ep_no" "$mode" || die "No sources found for $mode!"
    video_link=""
    [ "$quality" = best ] || video_link=$(printf "%s\n" "$links" | grep -m 1 "$quality")
    [ -z "$video_link" ] && video_link=$(printf "%s\n" "$links" | head -n 1)
    video_link=${video_link#*>}
    case "$player_function" in
        *mpv*) ;;
        *) die "fake ani-cli: only mpv-like players are supported" ;;
    esac
    if [ "$no_detach" = 1 ]; then
        $player_function --referrer="$refr" ${sub_link:+--sub-file="$sub_link"} --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
        _status=$?
        [ "$exit_after_play" = 1 ] && exit "$_status"
    else
        nohup $player_function --referrer="$refr" ${sub_link:+--sub-file="$sub_link"} --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
    fi
    printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"$histfile"
    [ "$menu_program" != fzf ] && wait
}

mode="${ANI_CLI_MODE:-sub}"
quality="${ANI_CLI_QUALITY:-best}"
player_function="${ANI_CLI_PLAYER:-mpv}"
no_detach="${ANI_CLI_NO_DETACH:-0}"
exit_after_play="${ANI_CLI_EXIT_AFTER_PLAY:-0}"
menu_program="${ANI_CLI_MENU:-fzf}"
if [ ! -t 0 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi
hist_dir="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ani-cli}"
[ -d "$hist_dir" ] || mkdir -p "$hist_dir"
histfile="$hist_dir/ani-hsts"
[ -f "$histfile" ] || : >"$histfile"
search_api="https://hianime.example/search?keyword=%s"

while [ $# -gt 0 ]; do
    case "$1" in
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --dub) mode="dub" ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -U | --update) update_script ;;
        -V | --version)
            printf "5.1.5 (fake)\n"
            exit 0
            ;;
        -v | --vlc | -s | --syncplay | -c | --continue | -d | --download | -l | --logview | -h | --help | --rofi | --dmenu | --skip | -N | --nextep-countdown)
            die "fake ani-cli: $1 is not supported"
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

[ "$menu_program" = fzf ] && menu_multi_flag="-m"
[ "$menu_program" = rofi ] && menu_multi_flag="-multi-select"

info "Checking dependencies..."
command -v "$menu_program" >/dev/null || die "Program $menu_program not found. Please install it."
command -v "$player_function" >/dev/null || die "Program $player_function not found. Please install it."
[ -n "$query" ] || die "fake ani-cli: no query (ani-cli would ask for one)"

anime_list=$(hianime_search "$query") || exit 1
[ -z "$anime_list" ] && die "No results found!"
if [ -n "$index" ]; then
    result=$(printf "%s\n" "$anime_list" | sed -n "${index}p")
else
    result=$(printf "%s\n" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")
fi
[ -z "$result" ] && die "Invalid anime selection"
anime_id="$(printf "%s" "$result" | cut -f 1)"
anime_title="$(printf "%s" "$result" | cut -f 2)"
ep_list="$(hianime_episodes "$anime_id" | cut -f 2)"
[ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$menu_multi_flag")
[ -z "$ep_no" ] && die "Invalid episode selection"

play_episode
while cmd=$(printf "next\nreplay\nprevious\nselect\nchange_quality\nquit" | nth "Playing episode $ep_no of $anime_title... "); do
    [ "$cmd" = next ] || exit 0
    ep_no=$(printf "%s\n" "$ep_list" | sed -n "/^${ep_no}\$/{n;p;}")
    [ -z "$ep_no" ] && die "Out of range"
    play_episode
done
