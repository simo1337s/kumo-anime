post_install() {
    echo ">> Kumo installed. Start it from your app menu or run: kumo"
    echo ">> For sub/dub streaming install ani-cli:   yay -S ani-cli"
    echo ">> Optional:                                sudo pacman -S yt-dlp qbittorrent"
    echo ">> Headless/LAN server (no window):         systemctl --user enable --now kumo-server"
}

post_upgrade() {
    echo ">> Kumo updated. If it's open, open it again from the app menu: it restarts as the new version."
    echo ">> Using the headless server?            systemctl --user restart kumo-server"
}
